# Copy this file to .env and fill in your own values. Never commit .env.
PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=maintainiq
DB_PASSWORD=change-me
DB_NAME=maintainiq
DB_NAME_TEST=maintainiq_test
# Set to true when your hosted MySQL requires TLS (Aiven, TiDB Cloud, etc.)
DB_SSL=false

# Long random string used to sign login tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h

# Password given to the demo users created by `npm run db:setup`
SEED_PASSWORD=choose-a-demo-password

# Comma-separated origins allowed to call the API from another domain.
# Leave empty when the frontend is served by this same server.
CORS_ORIGINS=

# Public demo mode: protects the seeded demo accounts and records and shows DEMO_PASSWORD on the
# login page. DEMO_PASSWORD is deliberately public; it must match the SEED_PASSWORD used by db:setup.
DEMO_MODE=false
DEMO_PASSWORD=

# Optional rate-limit overrides (defaults: 10 failed logins per 15 min, 10 registrations per hour, per IP)
# AUTH_LOGIN_MAX=10
# AUTH_REGISTER_MAX=10
